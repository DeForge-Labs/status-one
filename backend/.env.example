# Server
PORT=3000

# JWT Secret (generate a strong random string)
JWT_SECRET=change-me-to-a-random-secret

# Set to the number of reverse proxies in front of the server (e.g. 1) so rate limiting
# uses the real client IP from X-Forwarded-For. Leave unset when exposed directly.
# TRUST_PROXY=1

# SMTP Configuration (for password reset emails & email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="Status One <noreply@example.com>"
